# ---------------------------------------------------------------------------
# YieldFlow environment variables
#
# Local development: a libSQL file URL is all you need. Everything runs offline.
#   DATABASE_URL="file:local.db"
#
# Production (Vercel): point at a hosted Turso database. libSQL IS SQLite, so
# the same schema/driver works — a plain SQLite *file* would not persist on
# Vercel's serverless filesystem. Create one with:
#   turso db create yieldflow
#   turso db show yieldflow --url           # -> DATABASE_URL
#   turso db tokens create yieldflow        # -> DATABASE_AUTH_TOKEN
# Then add both to Vercel: Project Settings -> Environment Variables.
# ---------------------------------------------------------------------------

DATABASE_URL="file:local.db"

# Only required when DATABASE_URL is a remote libsql:// URL (Turso). Leave blank
# for local file databases.
DATABASE_AUTH_TOKEN=""

# The app also accepts the variable names injected by the Turso–Vercel native
# integration, so you don't have to duplicate them on Vercel:
#   TURSO_DATABASE_URL=...
#   TURSO_AUTH_TOKEN=...
# Resolution order: DATABASE_URL -> TURSO_DATABASE_URL -> file:local.db.
