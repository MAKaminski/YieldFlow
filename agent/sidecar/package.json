{
  "name": "yieldflow-agent-sidecar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Playwright driver that pre-fills a bank application on the user's machine.",
  "bin": { "yieldflow-sidecar": "run.mjs" },
  "scripts": {
    "start": "node run.mjs",
    "build:bin": "pkg run.mjs --targets node18-win-x64,node18-macos-x64,node18-linux-x64 --output ../src-tauri/binaries/yieldflow-sidecar"
  },
  "dependencies": {
    "playwright": "^1.48.0"
  },
  "devDependencies": {
    "pkg": "^5.8.1"
  }
}
