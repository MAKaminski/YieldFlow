{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YieldFlow Agent",
  "version": "0.1.0",
  "identifier": "app.yieldflow.agent",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "title": "YieldFlow Agent",
        "width": 520,
        "height": 380,
        "resizable": true
      }
    ],
    "security": { "csp": null }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["yieldflow"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "appimage"],
    "externalBin": ["binaries/yieldflow-sidecar"],
    "icon": ["icons/icon.png"]
  }
}
